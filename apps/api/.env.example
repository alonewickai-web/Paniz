NODE_ENV=development
PORT=4000
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=mysql://panizstyle_app:panizstyle-local-change-this@127.0.0.1:3306/panizstyle
DATABASE_CONNECTION_LIMIT=10
UPLOADS_DIR=./uploads
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=7
BACKUP_SCHEDULE_ENABLED=true
MYSQLDUMP_PATH=mysqldump

# Optional SMS.ir credentials; never commit real values
SMS_PROVIDER=console
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
SMSIR_BULK_URL=https://api.sms.ir/v1/send/bulk

# Optional social publishing credentials; never commit real values
RUBIKA_BOT_TOKEN=
RUBIKA_CHANNEL_ID=
RUBIKA_BOT_API_URL=
RUBIKA_BOT_API_BASE_URL=https://botapi.rubika.ir/v3
RUBIKA_WEBHOOK_BASE_URL=
RUBIKA_SEND_DELAY_MS=150
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=
