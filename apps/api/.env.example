NODE_ENV=development
PORT=4000
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_WEB_URL=https://panizstyle.ir
PUBLIC_API_URL=https://api.panizstyle.ir
DATABASE_URL=mysql://panizstyle_app:panizstyle-local-change-this@127.0.0.1:3306/panizstyle
DATABASE_CONNECTION_LIMIT=10
UPLOADS_DIR=./uploads
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=7
BACKUP_SCHEDULE_ENABLED=true
MYSQLDUMP_PATH=mysqldump

# Optional SMS.ir credentials; never commit real values
SMS_PROVIDER=console
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
SMSIR_BULK_URL=https://api.sms.ir/v1/send/bulk
# Keep production SMS campaigns disabled unless their queue is reviewed and enabled deliberately.
SMS_CAMPAIGNS_ENABLED=false
# OTP templates: set the approved template ID to use Verify instead of Bulk.
SMSIR_OTP_TEMPLATE_ID=
SMSIR_OTP_PARAMETER=Code
SMSIR_VERIFY_URL=https://api.sms.ir/v1/send/verify
# Local Sandbox only: SMS_PROVIDER=smsir-sandbox with SMSIR_SANDBOX_API_KEY.
SMSIR_SANDBOX_API_KEY=
# Uses fixed template 123456 / Code; returns developmentCode, sends no real SMS.
# Never use smsir-sandbox in NODE_ENV=production.

# Optional social publishing credentials; never commit real values
RUBIKA_BOT_TOKEN=
RUBIKA_CHANNEL_ID=
RUBIKA_BOT_API_BASE_URL=https://botapi.rubika.ir/v3
RUBIKA_WEBHOOK_BASE_URL=
RUBIKA_SEND_DELAY_MS=150
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=

# Optional read-only Google Search Console / GA4 reporting credentials.
# Add the service account to the Search Console property and GA4 property first.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://panizstyle.ir/
GA4_PROPERTY_ID=
GA4_CURRENCY_CODE=IRR
SEO_ALERT_DROP_PERCENT=30
SEO_ALERT_POSITION_DROP=3
GOOGLE_ANALYTICS_SYNC_ENABLED=true
